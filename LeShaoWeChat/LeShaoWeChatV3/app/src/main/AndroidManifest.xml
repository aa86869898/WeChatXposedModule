<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ 包可见性：模块 app 需主动向微信进程发广播（刷新配置/会话中转） -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="乐少助手"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="com.leshao.v3" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:value="com.tencent.mm" />

        <!-- 设置页仅允许模块自身进程启动，禁止外部 App 任意拉起。 -->
        <activity
            android:name="com.leshao.ai.ui.activity.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.LeshaoAI" />

        <!-- 必须 exported=true 供宿主微信(com.tencent.mm)跨应用访问；
             改由 AiDataProvider#isCallerTrusted 按调用方 UID 白名单鉴权，
             关闭 URI 授权以缩小攻击面。 -->
        <provider
            android:name="com.leshao.ai.data.AiDataProvider"
            android:authorities="com.leshao.v3.aiconfig"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- 微信侧（模块 hook 进程）通过显式广播请求配置 / 回传会话，
             因 Android 11+ 包可见性无法让微信反向解析本 app 的 ContentProvider。
             必须 exported=true 供宿主微信跨应用投递；
             改由 BridgeReceiver#isCallerTrusted 按发送方 UID 白名单鉴权。 -->
        <receiver
            android:name="com.leshao.ai.data.BridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.leshao.ai.action.REQUEST_CONFIG" />
                <action android:name="com.leshao.ai.action.PUSH_SESSIONS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
