<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="LeShao"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="com.leshao.v3" />
        <meta-data
            android:name="xposedminversion"
            android:value="102" />
        <meta-data
            android:name="xposedscope"
            android:value="com.tencent.mm" />

        <activity
            android:name="com.leshao.v3.SettingsActivity"
            android:exported="true"
            android:label="微信乐少助手"
            android:theme="@android:style/Theme.Holo.Light.NoActionBar" />

        <provider
            android:name="com.leshao.v3.hook.SettingsInjectProvider"
            android:authorities="com.leshao.v3.provider.inject"
            android:exported="false" />
    </application>

</manifest>
